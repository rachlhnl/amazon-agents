# Copy to .env and fill in. Never commit .env.

# --- Mode ---
# recommend: agents only propose actions (default, safe)
# approve:   actions queue for human approval, then execute
# auto:      actions within guardrails execute automatically
AGENT_MODE=recommend

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Amazon Selling Partner API (Login with Amazon credentials) ---
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_REGION=na            # na | eu | fe
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER   # US

# --- Amazon Ads API ---
ADS_API_CLIENT_ID=
ADS_API_CLIENT_SECRET=
ADS_API_REFRESH_TOKEN=
ADS_API_PROFILE_ID=
ADS_API_REGION=na

SP_API_SELLER_ID=           # merchant token, for listings and price updates
COSTS_CSV=                  # sku,landed_cost,lead_time_days (or `ingest --costs FILE`)

# --- Shopify (own store; optional) ---
SHOPIFY_SHOP=               # yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=       # custom app: read_products, write_products, read_orders
SHOPIFY_API_VERSION=2025-10
SHOPIFY_FULFILLMENT=own     # mcf if Shopify orders ship from FBA stock
SHOPIFY_FEE_PCT=0.029       # payment processing
SHOPIFY_FEE_FIXED=0.30
SHOPIFY_FULFILLMENT_COST=0  # per unit (MCF fee or your 3PL)

# --- Meta ads (optional) ---
META_AD_ACCOUNT_ID=         # act_... or the number
META_ACCESS_TOKEN=          # system user token with ads_management
META_API_VERSION=v23.0

# --- Storage ---
WAREHOUSE_PATH=data/warehouse.db

# --- Guardrails (hard limits enforced in code) ---
TARGET_ACOS=0.25
MAX_BID_CHANGE_PCT=0.20      # max +/- per bid per day
MIN_BID=0.20
MAX_BID=5.00
MAX_DAILY_BUDGET=500.00      # per campaign
MIN_MARGIN_PCT=0.15          # price floor = landed cost + fees + this margin
MAX_PRICE_CHANGE_PCT=0.10    # max +/- per price change
MAX_BUDGET_CHANGE_PCT=0.20   # max +/- per external campaign budget change

# --- Chief of staff ---
GOALS_PATH=goals.toml

# --- Brief delivery (optional; brief is always written to reports/) ---
# Use an SMTP account on the company's domain, e.g. a Google Workspace or
# Microsoft 365 mailbox with an app password, or a transactional provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BRIEF_FROM=
BRIEF_TO=            # comma-separated, e.g. ops@company.com,marketing@company.com
